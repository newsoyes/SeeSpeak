// ============================================================================
// SeeSpeak: อุปกรณ์เสริมแว่นตาอัจฉริยะสำหรับผู้พิการทางสายตา
// ไฟล์ต้นฉบับ OpenSCAD (.scad) สำหรับพิมพ์ 3 มิติ (3D Print)
// ออกแบบสำหรับอุปกรณ์จริง:
//   1. บอร์ด Seeed Studio XIAO ESP32S3 Sense + กล้อง OV5640 (สายแพสั้น 2 ซม.)
//   2. โมดูลแอมป์ MAX98357A I2S + ลำโพงกลมขนาด 20 มม. (8 Ohm 1W)
//   3. แบตเตอรี่ LiPo 401030 (หนา 4 x กว้าง 10 x ยาว 30 มม.) 130mAh
//   4. มอเตอร์สั่นเหรียญ 10x3 มม. + เม็ดไฟแฟลช SMD LED 3V 60mA
//   5. ปุ่มกด Tactile 6x6 มม. + สวิตช์เลื่อนเปิด-ปิด SS-12D00
//   6. แท่นแม่เหล็กยึดขาแว่นแบบสี่เหลี่ยมผืนผ้า (แปะกาว 2 หน้ากับขาแว่น)
// ============================================================================

$fn = 64; // ความละเอียดของวงกลมและมุมโค้ง

// ----------------------------------------------------------------------------
// [ตั้งค่าพารามิเตอร์ขนาดอุปกรณ์ - สามารถปรับแก้ตัวเลขได้ตามต้องการ]
// ----------------------------------------------------------------------------

// เลือกชิ้นส่วนที่ต้องการแสดงผล:
// "all"   = แสดงครบทุกชิ้นวางเรียงกันพร้อมสั่งปริ้นท์
// "body"  = เฉพาะตัวกล่องหลัก (Main Enclosure Body)
// "lid"   = เฉพาะฝาปิดด้านข้างพร้อมเบ้าแม่เหล็ก (Magnetic Inner Lid)
// "mount" = เฉพาะแผ่นสี่เหลี่ยมผืนผ้าติดขาแว่นด้วยกาว 2 หน้า (Glasses Mount Plate)
part_to_render = "all";

// 1. ขนาดโครงสร้างกล่องหลัก (มิลลิเมตร)
case_length = 56.0;        // ความยาวรวมของเคส (ส่วนหน้าใส่บอร์ด+กล้อง, ส่วนหลังใส่ลำโพง 20mm+แบต)
case_height = 24.0;        // ความสูงของเคส (รองรับลำโพงกลม 20 มม. + ขอบผนังบนล่างข้างละ 2 มม.)
case_width  = 16.5;        // ความหนาของเคส (รองรับบอร์ด XIAO Sense + แบต 401030 แบบประกบแซนด์วิช)
wall_thick  = 1.6;         // ความหนาผนังเคส
corner_r    = 2.2;         // รัศมีลบมุมโค้ง

// 2. มุมก้มของกล้องด้านหน้า (Camera Down-Tilt)
cam_tilt_angle = 15.0;     // มุมก้ม 15 องศา สำหรับส่องหนังสือและธนบัตรในระดับอก
cam_lens_hole  = 8.8;      // ขนาดช่องเลนส์กล้อง OV5640 (ตัวเลนส์จริง 8.5x8.5 มม.)
led_hole_d     = 4.2;      // ขนาดช่องไฟแฟลช SMD LED ข้างกล้อง

// 3. ขนาดลำโพงกลม 20 มม. (รายการที่ 2 และ 9)
spk_diameter   = 20.6;     // เส้นผ่านศูนย์กลางเบ้าใส่ลำโพง (เผื่อหลวม 0.6 มม. จาก 20.0 มม.)
spk_depth      = 4.2;      // ความลึกเบ้าลำโพง
spk_pos_x      = 42.0;     // ตำแหน่งจุดศูนย์กลางลำโพง (ค่อนไปทางด้านหลังใกล้ใบหู)

// 4. ขนาดแบตเตอรี่ LiPo 401030 (หนา 4 x กว้าง 10 x ยาว 30 มม.)
bat_length     = 32.0;     // ความยาวช่องใส่แบต
bat_width      = 10.8;     // ความกว้างช่องใส่แบต
bat_thick      = 4.6;      // ความหนาช่องใส่แบต

// 5. ขนาดมอเตอร์สั่นเหรียญ 10x3 มม. (รายการที่ 7)
vib_diameter   = 10.5;     // เส้นผ่านศูนย์กลางเบ้าใส่มอเตอร์สั่น (เผื่อหลวม 0.5 มม.)
vib_depth      = 3.2;      // ความลึกเบ้าใส่มอเตอร์สั่น

// 6. ขนาดปุ่มกด 6x6 มม. และสวิตช์เลื่อน SS-12D00
btn_hole_size  = 6.5;      // ช่องใส่ปุ่มกด Tactile 6x6 มม.
btn_pos_x      = 16.0;     // ตำแหน่งปุ่มกดด้านข้าง (ใกล้ส่วนหน้า กดง่ายด้วยนิ้วชี้/นิ้วโป้ง)
sw_hole_len    = 9.0;      // ความยาวช่องสวิตช์เลื่อนเปิด-ปิด SS-12D00
sw_hole_wid    = 4.2;      // ความกว้างช่องสวิตช์เลื่อน

// 7. ขนาดพอร์ตชาร์จ USB Type-C ของบอร์ด XIAO
usbc_wid       = 9.6;      // ความกว้างรูเสียบสายชาร์จ Type-C
usbc_hei       = 4.2;      // ความสูงรูเสียบสายชาร์จ Type-C

// 8. ขนาดแม่เหล็กนีโอไดเมียม และ แผ่นสี่เหลี่ยมติดขาแว่น (Glasses Mount Plate)
mag_diameter   = 5.3;      // เส้นผ่านศูนย์กลางเบ้าฝังแม่เหล็กกลม (สำหรับแม่เหล็ก 5x2 มม. หากใช้ 6x2 มม. แก้เป็น 6.3)
mag_depth      = 2.1;      // ความลึกเบ้าฝังแม่เหล็ก (สำหรับแม่เหล็กหนา 2 มม.)
mag_spacing    = 20.0;     // ระยะห่างระหว่างแม่เหล็ก 2 เม็ด
mount_length   = 36.0;     // ความยาวแผ่นสี่เหลี่ยมติดขาแว่น
mount_height   = 11.0;     // ความกว้างแผ่นสี่เหลี่ยมติดขาแว่น (พอดีกับความกว้างขาแว่นทั่วไป)
mount_thick    = 3.2;      // ความหนาแผ่นติดขาแว่น (ฝังแม่เหล็กได้มิดและแข็งแรง)


// ============================================================================
// โมดูลสร้างรูปทรงกล่องลบมุมโค้ง (Rounded Box)
// ============================================================================
module rounded_box(l, w, h, r) {
    hull() {
        for (x = [r, l - r]) {
            for (y = [r, w - r]) {
                translate([x, y, 0])
                    cylinder(r = r, h = h);
            }
        }
    }
}

// ============================================================================
// ชิ้นที่ 1: ตัวกล่องหลัก (Main Enclosure Body)
// ============================================================================
module seespeak_main_body() {
    difference() {
        // 1. ก้อนกล่องหลักภายนอก
        rounded_box(case_length, case_width, case_height, corner_r);

        // 2. ปาดหน้าด้านหน้าเอียงก้ม 15 องศา (สำหรับหน้ากล้องและไฟแฟลช)
        translate([0, -1, case_height])
            rotate([0, cam_tilt_angle, 0])
                translate([-15, 0, -case_height * 1.5])
                    cube([15, case_width + 2, case_height * 2]);

        // 3. คว้านโพรงด้านในสำหรับวางอุปกรณ์ (เปิดฝาด้านบน z = case_height เพื่อใส่ของและปิดฝา)
        translate([wall_thick + 2.5, wall_thick, wall_thick])
            cube([
                case_length - (wall_thick * 2) - 2.5,
                case_width - (wall_thick * 2),
                case_height
            ]);

        // 4. เจาะช่องเลนส์กล้อง OV5640 ด้านหน้า (ตรงกึ่งกลางความสูงส่วนบน)
        translate([2.2, case_width / 2, case_height * 0.62])
            rotate([0, cam_tilt_angle, 0])
                translate([0, 0, 0])
                    rotate([0, 90, 0])
                        translate([0, 0, -10])
                            cylinder(d = cam_lens_hole, h = 20);

        // 5. เจาะช่องเม็ดไฟแฟลช SMD LED (อยู่ด้านล่างเลนส์กล้อง)
        translate([3.5, case_width / 2, case_height * 0.28])
            rotate([0, cam_tilt_angle, 0])
                rotate([0, 90, 0])
                    translate([0, 0, -10])
                        cylinder(d = led_hole_d, h = 20);

        // 6. เจาะช่องปุ่มกดสั่งงาน 6x6 มม. (อยู่ที่ผนังด้านนอก y = 0 กดง่ายด้วยนิ้วชี้/โป้ง)
        translate([btn_pos_x - (btn_hole_size / 2), -1, (case_height - btn_hole_size) / 2])
            cube([btn_hole_size, wall_thick + 3, btn_hole_size]);

        // 7. เจาะช่องเสียบสายชาร์จ USB Type-C ที่ผนังด้านหลัง (x = case_length)
        translate([case_length - wall_thick - 1, (case_width - usbc_wid) / 2, 3.5])
            cube([wall_thick + 2, usbc_wid, usbc_hei]);

        // 8. เจาะช่องสวิตช์เลื่อนเปิด-ปิด SS-12D00 ที่ผนังด้านหลังส่วนบน
        translate([case_length - wall_thick - 1, (case_width - sw_hole_wid) / 2, case_height - 7.5])
            cube([wall_thick + 2, sw_hole_wid, sw_hole_len - 2]);

        // 9. เจาะรูตะแกรงเสียงลำโพง 20 มม. (Speaker Sound Slots) ออกทางด้านล่างและด้านข้างใกล้หู
        for (i = [-2 : 2]) {
            translate([spk_pos_x + (i * 2.8) - 0.8, 3.0, -1])
                cube([1.6, case_width - 6.0, wall_thick + 2]);
        }
        // รูระบายเสียงด้านข้างฝั่งใบหู
        for (j = [-2 : 2]) {
            translate([spk_pos_x + (j * 2.8) - 0.8, -1, (case_height / 2) - 5.0])
                cube([1.6, wall_thick + 2, 10.0]);
        }

        // 10. เบ้าวงกลมด้านในสำหรับวางลำโพง 20 มม. ให้ล็อกแน่นไม่ขยับ
        translate([spk_pos_x, wall_thick + 0.8, case_height / 2])
            rotate([90, 0, 0])
                cylinder(d = spk_diameter, h = 2.0);
    }

    // 11. ผนังกั้นภายในแบบเตี้ย (Interior Partition / Barrier) แยกโซนบอร์ด XIAO (หน้า) กับ โซนลำโพง 20 มม. (หลัง)
    // มีช่องเว้นตรงกลางให้สายไฟ 30AWG ลอดผ่านได้สะดวก
    translate([28.5, wall_thick, wall_thick])
        cube([1.4, 3.5, case_height - 5.0]);
    translate([28.5, case_width - wall_thick - 3.5, wall_thick])
        cube([1.4, 3.5, case_height - 5.0]);
}

// ============================================================================
// ชิ้นที่ 2: ฝาปิดฝั่งชิดขาแว่น + เบ้าฝังแม่เหล็ก 2 เม็ด + เบ้าใส่มอเตอร์สั่นที่ขมับ
// ============================================================================
module seespeak_lid_cover() {
    lid_l = case_length - 3.0;
    lid_w = case_width;
    lid_h = 3.2;

    difference() {
        union() {
            // แผ่นฝาปิดหลัก
            rounded_box(lid_l, lid_w, lid_h, corner_r);

            // ขอบบ่าด้านใน (Lip) สำหรับกดล็อกเข้ากับตัวกล่องหลักแบบ Snap-fit
            translate([wall_thick + 0.25, wall_thick + 0.25, lid_h])
                cube([
                    lid_l - (wall_thick * 2) - 0.5,
                    lid_w - (wall_thick * 2) - 0.5,
                    1.6
                ]);
        }

        // คว้านด้านในขอบบ่าให้โปร่งและมีเบ้าใส่มอเตอร์สั่นเหรียญ 10x3 มม. (เพื่อให้สั่นถึงขมับได้แรง)
        translate([wall_thick + 1.6, wall_thick + 1.6, lid_h - 0.5])
            cube([
                lid_l - (wall_thick * 2) - 3.2,
                lid_w - (wall_thick * 2) - 3.2,
                2.5
            ]);

        // เบ้ากลมด้านในสำหรับวางมอเตอร์สั่นเหรียญ 10x3 มม. ชิดผนังฝั่งขมับ
        translate([lid_l * 0.65, lid_w / 2, lid_h - 1.2])
            cylinder(d = vib_diameter, h = vib_depth);

        // เบ้าฝังแม่เหล็กนีโอไดเมียม 2 เม็ด ด้านนอกฝา (z = 0) สำหรับดูดติดกับแผ่นยึดขาแว่น
        translate([(lid_l / 2) - (mag_spacing / 2), lid_w / 2, -0.1])
            cylinder(d = mag_diameter, h = mag_depth + 0.1);
        translate([(lid_l / 2) + (mag_spacing / 2), lid_w / 2, -0.1])
            cylinder(d = mag_diameter, h = mag_depth + 0.1);

        // ร่องบ่าบังคับทิศทาง (Alignment Groove) ตรงกลางระหว่างแม่เหล็ก 2 เม็ด
        // ช่วยล็อกไม่ให้ตัวเคสหมุนเอียงเวลาติดอยู่บนขาแว่น
        translate([(lid_l / 2) - 4.0, (lid_w / 2) - 2.2, -0.1])
            cube([8.0, 4.4, 1.3]);
    }
}

// ============================================================================
// ชิ้นที่ 3: แผ่นสี่เหลี่ยมผืนผ้าติดขาแว่น (Glasses Mount Plate)
// ด้านเรียบใช้แปะกาว 2 หน้าติดขาแว่น อีกด้านฝังแม่เหล็ก 2 เม็ดประกบกับตัวเคส
// ============================================================================
module seespeak_glasses_mount_plate() {
    difference() {
        union() {
            // แผ่นฐานสี่เหลี่ยมผืนผ้าลบมุมโค้ง (ด้าน z=0 เรียบสนิทสำหรับติดเทปกาว 2 หน้า 3M กับขาแว่น)
            rounded_box(mount_length, mount_height, mount_thick, 1.8);

            // เดือยสี่เหลี่ยมบังคับทิศทางตรงกลาง (Alignment Key) ประกบเข้ากับร่องบนฝาเคสพอดี
            translate([(mount_length / 2) - 3.8, (mount_height / 2) - 2.0, mount_thick])
                cube([7.6, 4.0, 1.1]);
        }

        // เบ้าฝังแม่เหล็กนีโอไดเมียม 2 เม็ด (ระยะห่างตรงกับฝาเคสเป๊ะ)
        translate([(mount_length / 2) - (mag_spacing / 2), mount_height / 2, mount_thick - mag_depth])
            cylinder(d = mag_diameter, h = mag_depth + 0.2);
        translate([(mount_length / 2) + (mag_spacing / 2), mount_height / 2, mount_thick - mag_depth])
            cylinder(d = mag_diameter, h = mag_depth + 0.2);
    }
}

// ============================================================================
// ชิ้นที่ 4 (แถม): ฝาครอบปุ่มกดทรงกลมนูน (Tactile Button Cap) ให้คลำเจอง่าย
// ============================================================================
module seespeak_button_cap() {
    difference() {
        union() {
            cylinder(d = 8.5, h = 1.2);
            translate([0, 0, 1.2])
                cylinder(d = 5.8, h = 2.5);
        }
        // รูเสียบก้านปุ่ม Tactile Switch
        translate([-1.7, -1.7, -0.1])
            cube([3.4, 3.4, 2.2]);
    }
}

// ============================================================================
// สั่งแสดงผลตามโหมดที่เลือก
// ============================================================================
if (part_to_render == "body") {
    seespeak_main_body();
} else if (part_to_render == "lid") {
    seespeak_lid_cover();
} else if (part_to_render == "mount") {
    seespeak_glasses_mount_plate();
} else {
    // วางเรียงทั้ง 4 ชิ้นบนฐานพิมพ์เดียวกัน พร้อมส่งเข้าโปรแกรม Slicer สั่งปริ้นท์ได้ทันที
    seespeak_main_body();

    translate([0, case_width + 6, 0])
        seespeak_lid_cover();

    translate([0, (case_width * 2) + 12, 0])
        seespeak_glasses_mount_plate();

    translate([mount_length + 10, (case_width * 2) + 17, 0])
        seespeak_button_cap();
}
